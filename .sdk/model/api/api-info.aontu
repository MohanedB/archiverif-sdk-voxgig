          url: "https://verifrbq-backend-production.up.railway.app"
        }
      ]
      summary: "Québec construction-compliance monitoring: RBQ contractor-licence verification plus RENA (AMP) ineligibility status, with a company watchlist keyed on NEQ."
      termsOfService: "https://archiverif.ca/terms"
      title: "ArchiVerif API"
      version: "1.0.0"
      website: "https://verifrbq-backend-production.up.railway.app"
    }
